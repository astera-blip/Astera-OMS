# Firebase web app config. These are not server secrets, but real values should
# stay in local environment files and hosting provider environment settings.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Emulator usage is local only.
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=false

# E2E-only email/password helper route. Keep false outside local Playwright emulator runs.
NEXT_PUBLIC_ENABLE_E2E_TEST_AUTH=false

# Local/CI build preference.
NEXT_TELEMETRY_DISABLED=1

# Resend email delivery. Leave API key empty until updates.asteratw.com is DNS verified.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Astera <orders@updates.asteratw.com>
RESEND_REPLY_TO_EMAIL=astera.0920@gmail.com
