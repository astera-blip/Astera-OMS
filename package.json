{
  "name": "astera-oms",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.18.0 <25",
    "npm": ">=11"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit && npm run firebase:rules:test",
    "test:unit": "vitest run tests/unit",
    "test:e2e": "playwright test",
    "test:e2e:emulated": "node scripts/run-firebase.mjs emulators:exec --only auth,firestore,storage --project demo-astera-oms \"node scripts/run-playwright-emulated.mjs\"",
    "test:rules": "vitest run tests/firebase",
    "audit:production": "npm audit --omit=dev --audit-level=high",
    "production:env:check": "node scripts/check-production-env.mjs",
    "production:products:audit": "node scripts/audit-product-projection.mjs",
    "production:products:sync": "node scripts/sync-product-projection.mjs",
    "production:smoke": "node scripts/smoke-production.mjs",
    "check:secrets": "node scripts/check-no-secrets.mjs",
    "admin:set-role": "node scripts/set-user-role.mjs",
    "firebase:version": "node scripts/run-firebase.mjs --version",
    "firebase:emulators": "node scripts/run-firebase.mjs emulators:start --only auth,firestore,storage --project demo-astera-oms",
    "firebase:emulators:seed": "node scripts/seed-firebase-emulator.mjs",
    "firebase:rules:test": "node scripts/run-firebase.mjs emulators:exec --only firestore,storage --project demo-astera-oms \"npm run test:rules\""
  },
  "dependencies": {
    "@google-cloud/kms": "^5.7.0",
    "@vercel/oidc": "^3.8.1",
    "exceljs": "^4.4.0",
    "firebase": "^12.16.0",
    "google-auth-library": "^10.9.1",
    "next": "16.2.11",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1"
    },
    "nanoid": "3.3.18",
    "postcss": "8.5.23",
    "sharp": "0.35.3"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "@playwright/test": "^1.62.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "firebase-admin": "13.10.0",
    "firebase-tools": "^15.24.0",
    "tailwindcss": "^4",
    "typescript": "^7",
    "vitest": "^4.1.10"
  }
}
