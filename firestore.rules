rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner() {
      return isSignedIn() && request.auth.token.role == 'owner';
    }

    function isOwnDocument(memberId) {
      return isSignedIn() && request.auth.uid == memberId;
    }

    function hasValidMemberShape(data) {
      return data.keys().hasAll([
          'uid', 'email', 'displayName', 'communityId', 'mobilePhone',
          'completedAt', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid', 'email', 'displayName', 'communityId', 'mobilePhone',
          'birthday', 'completedAt', 'createdAt', 'updatedAt'
        ])
        && data.uid is string
        && data.email is string
        && data.displayName is string
        && data.displayName.size() > 0
        && data.displayName.size() <= 80
        && data.communityId is string
        && data.communityId.size() > 0
        && data.communityId.size() <= 80
        && data.mobilePhone is string
        && data.mobilePhone.matches('^09[0-9]{8}$')
        && (!('birthday' in data)
          || (data.birthday is string
            && data.birthday.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')))
        && data.completedAt is timestamp
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /members/{memberId} {
      allow get: if isOwnDocument(memberId) || isOwner();
      allow list: if isOwner();

      allow create: if isOwnDocument(memberId)
        && hasValidMemberShape(request.resource.data)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.completedAt == request.time
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if isOwnDocument(memberId)
        && hasValidMemberShape(request.resource.data)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.email == resource.data.email
        && request.resource.data.completedAt == resource.data.completedAt
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName', 'communityId', 'mobilePhone', 'birthday', 'updatedAt'
        ])
        && request.resource.data.updatedAt == request.time;

      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
