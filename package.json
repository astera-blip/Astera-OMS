{
  "name": "astera-oms",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.18.0 <25",
    "npm": ">=11"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:rules": "vitest run tests/firebase",
    "check:secrets": "node scripts/check-no-secrets.mjs",
    "firebase:version": "node scripts/run-firebase.mjs --version",
    "firebase:emulators": "node scripts/run-firebase.mjs emulators:start --only auth,firestore,storage --project demo-astera-oms",
    "firebase:rules:test": "node scripts/run-firebase.mjs emulators:exec --only firestore --project demo-astera-oms \"npm run test:rules\""
  },
  "dependencies": {
    "firebase": "^12.16.0",
    "next": "16.2.11",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "firebase-tools": "^15.24.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
